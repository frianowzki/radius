NEXT_PUBLIC_WEB3AUTH_CLIENT_ID=
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=

BLOB_READ_WRITE_TOKEN=
# Used by profile photo uploads and the global username/avatar registry JSON table.

# Circle User-Controlled Wallets (users control keys via Circle PIN challenge)
CIRCLE_API_KEY=
# User-Controlled Wallet App ID from Circle Console > Wallets > User Controlled > Configurator.
# CIRCLE_APP_ID is read at runtime; NEXT_PUBLIC_CIRCLE_APP_ID also works.
CIRCLE_APP_ID=
NEXT_PUBLIC_CIRCLE_APP_ID=
CIRCLE_USER_WALLET_CHAIN=ARC-TESTNET
# EOA is simplest; SCA is available for account abstraction/gas sponsorship on supported EVM chains.
CIRCLE_USER_WALLET_ACCOUNT_TYPE=EOA

# Circle Agent Wallet (testnet server-side integration)
CIRCLE_AGENT_WALLET_CHAIN=ARC-TESTNET
CIRCLE_AGENT_WALLET_ADDRESS=
# Optional: require Authorization: Bearer <token> for agent wallet mutations
AGENT_WALLET_ADMIN_TOKEN=
